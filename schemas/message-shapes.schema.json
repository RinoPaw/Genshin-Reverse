{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Genshin-Reverse protocol message shapes",
  "type": "object",
  "additionalProperties": {
    "$ref": "#/$defs/message"
  },
  "$defs": {
    "status": {
      "enum": ["CONFIRMED", "HIGH_CONFIDENCE", "CANDIDATE", "REJECTED", "UNRESOLVED"]
    },
    "field": {
      "type": "object",
      "required": ["number", "wire_type"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870911
        },
        "wire_type": {
          "type": "integer",
          "enum": [0, 1, 2, 3, 4, 5]
        },
        "likely_type": {
          "type": "string",
          "minLength": 1
        },
        "semantic": {
          "type": "string",
          "minLength": 1
        },
        "observed_value_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-fA-F]{2})*$"
        },
        "packed_varint_candidate": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "additionalProperties": true
    },
    "message": {
      "type": "object",
      "required": ["cmd_id", "direction", "fields", "status"],
      "properties": {
        "cmd_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "direction": {
          "enum": ["C2S", "S2C", "unknown"]
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "observed_payload_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-fA-F]{2})*$"
        }
      },
      "additionalProperties": true
    }
  }
}
