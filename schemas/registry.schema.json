{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical 7.1 registry row",
  "description": "Logical row shape for the xref-published registry/registry.csv identity dataset.",
  "type": "object",
  "required": [
    "index",
    "cmd_id",
    "type_name",
    "type_definition_index",
    "direction",
    "direction_status",
    "semantic_name",
    "type_slot_rva",
    "get_cmd_id_rva",
    "get_cmd_id_method",
    "load_rva",
    "store_rva",
    "xref_count",
    "xref_method_count",
    "status",
    "evidence"
  ],
  "properties": {
    "index": {"type": "integer", "minimum": 0},
    "cmd_id": {"type": "integer", "minimum": 0, "maximum": 65535},
    "type_name": {"type": "string", "minLength": 1},
    "type_definition_index": {"type": "integer", "minimum": 0},
    "direction": {"enum": ["C2S", "S2C", "unknown", ""]},
    "direction_status": {"enum": ["control-confirmed", "unresolved"]},
    "semantic_name": {"type": "string"},
    "type_slot_rva": {"type": "string", "pattern": "^0x[0-9A-Fa-f]+$"},
    "get_cmd_id_rva": {"type": "string", "pattern": "^0x[0-9A-Fa-f]+$"},
    "get_cmd_id_method": {"const": "AEGNNPENLNM"},
    "load_rva": {"type": "string", "pattern": "^0x[0-9A-Fa-f]+$"},
    "store_rva": {"type": "string", "pattern": "^0x[0-9A-Fa-f]+$"},
    "xref_count": {"type": "integer", "minimum": 0},
    "xref_method_count": {"type": "integer", "minimum": 0},
    "status": {"const": "static-verified-identity"},
    "evidence": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
